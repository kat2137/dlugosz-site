---
interface Props { number?: string; caption?: string; }
const { number, caption } = Astro.props;
---
<figure style="margin:2.5rem 0;background:var(--figure);color:var(--figure-ink)">
  <div class="wrap" style="padding-block:1.75rem">
    {number && <p class="meta" style="color:var(--figure-accent);margin:0 0 0.75rem">Fig. {number}</p>}
    <slot />
    {caption && (
      <figcaption class="meta" style="color:#8C9B93;margin-top:0.9rem;max-width:60ch">{caption}</figcaption>
    )}
  </div>
</figure>
