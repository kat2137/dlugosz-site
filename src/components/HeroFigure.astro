---
import { Image } from 'astro:assets';
import Turntable from './Turntable.astro';
import { media } from '../lib/media';
import type { Callout } from '../data/types';

interface Props {
  src: string;
  alt: string;
  /** CSS aspect-ratio for the figure, e.g. "16/10". */
  aspect: string;
  fit?: 'cover' | 'contain';
  callouts?: Callout[];
  caption: string;
  /**
   * Width of the figure column, as any CSS length. The rest of the band is
   * left for the callout labels, and the arrows are positioned against this
   * width — so a tall render can sit narrow with its labels beside it.
   */
  fig?: string;
  /** Swap the still for a scroll-scrubbed turntable. */
  turntable?: { name: string; frames: number; width: number; height: number; poster: string };
}

const { src, alt, aspect, fit = 'cover', callouts = [], caption, fig, turntable } = Astro.props;
const figure = fig ?? (callouts.length ? 'calc(100% - 250px)' : '100%');
const image = turntable ? null : media(src);
---

<div class="hero" style={`--fig:${figure}`}>
  {turntable ? (
    <Turntable
      {...turntable}
      alt={alt}
      fit={fit}
      sizes="(max-width: 900px) 100vw, 660px"
    />
  ) : (
    <Image
      src={image!}
      alt={alt}
      widths={[640, 960, 1280]}
      sizes="(max-width: 900px) 100vw, 910px"
      style={`aspect-ratio:${aspect};object-fit:${fit}`}
    />
  )}
  <div></div>
  {callouts.map((callout) => (
    <div
      class:list={['callout', callout.muted && 'callout--muted']}
      style={`top:${callout.top};--x:${callout.x}`}
      aria-hidden="true"
    >
      <span class="callout__label">{callout.label}</span>
      <span class="callout__rule"></span>
      <span class="callout__head"></span>
    </div>
  ))}
</div>
{callouts.length > 0 && (
  <ul class="callout-list">
    {callouts.map((callout) => <li>{callout.label}</li>)}
  </ul>
)}
<div class="caption">{caption}</div>
