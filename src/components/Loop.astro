---
interface Props { src: string; poster?: string; alt: string; caption?: string; }
const { src, poster, alt, caption } = Astro.props;
// Files in public/ are not processed by Astro, so the base path has to be
// applied by hand or these 404 on GitHub Pages.
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const posterSrc = poster?.startsWith('/') ? `${base}${poster}` : poster;
---
<figure class="wrap" style="margin:0;padding-block:2rem">
  <div style="background:#fff;border:1px solid var(--rule);display:flex;justify-content:center">
    <video
      autoplay
      loop
      muted
      playsinline
      poster={posterSrc}
      aria-label={alt}
      style="width:100%;max-width:520px;height:auto;display:block"
    >
      <source src={`${base}/media/${src}.webm`} type="video/webm" />
      <source src={`${base}/media/${src}.mp4`} type="video/mp4" />
    </video>
  </div>
  {caption && <figcaption class="meta" style="margin-top:0.7rem">{caption}</figcaption>}
</figure>
