---
import { url } from '../lib/paths';

interface Props {
  /** Which nav item is the current page. */
  current?: 'work' | 'lab' | 'about';
}

const { current = 'work' } = Astro.props;
---

<nav class="nav" aria-label="Primary">
  <div class="nav__inner">
    <a class="nav__mark" href={url()}>K. Długosz</a>
    <div class="nav__links">
      <a
        class:list={['nav__link', current === 'work' && 'is-current']}
        href={url()}
        aria-current={current === 'work' ? 'page' : undefined}>Work</a>
      <a
        class:list={['nav__link', current === 'lab' && 'is-current']}
        href={url('lab')}
        aria-current={current === 'lab' ? 'page' : undefined}>Lab</a>
      <a
        class:list={['nav__link', current === 'about' && 'is-current']}
        href={url('about')}
        aria-current={current === 'about' ? 'page' : undefined}>About</a>
    </div>
  </div>
</nav>
