---
import { Image } from 'astro:assets';
import { media, mediaForSlot } from '../lib/media';
import type { Plate } from '../data/types';

export type PlateStyle = 'hania' | 'sviatovid' | 'pneumabra' | 'sony';

interface Props {
  plate: Plate;
  style: PlateStyle;
  /** PneumaBra lays some plates out as full-width or as stacked 3:2 pairs. */
  as?: 'plate' | 'wide' | 'pair';
}

const { plate, style, as = 'plate' } = Astro.props;

/** Frame geometry per page, matching the prototype. */
function frameClass(): string {
  if (as === 'wide') return 'plate__frame--auto';
  if (as === 'pair') return 'plate__frame--pair';
  if (plate.size === 'small') return 'plate__frame--small';
  if (plate.size === 'large') return 'plate__frame--large';
  if (plate.tall) return 'plate__frame--tall';
  if (style === 'hania') return 'plate__frame--43 plate__frame--cover';
  if (style === 'sviatovid') return 'plate__frame--169 plate__frame--cover';
  if (style === 'sony') return plate.video ? 'plate__frame--169' : 'plate__frame--32';
  return 'plate__frame--169 plate__frame--cover';
}

/**
 * Plates that carry only a slot id are wired to the asset with the same stem
 * where one exists; the rest render as an empty frame with the placeholder.
 */
const image = plate.src ? media(plate.src) : plate.id ? mediaForSlot(plate.id) : null;
---

<div class="plate">
  {plate.video ? (
    <div class:list={['plate__frame', frameClass()]}>
      <iframe
        src={plate.video}
        title={plate.caption ?? 'Demo video'}
        loading="lazy"
        allow="accelerometer; autoplay; clipboard-write; encrypted-media; picture-in-picture"
        allowfullscreen
      ></iframe>
    </div>
  ) : image ? (
    <div class:list={['plate__frame', frameClass()]}>
      <Image
        src={image}
        alt={plate.alt ?? plate.caption ?? ''}
        widths={[380, 600, 900]}
        sizes="(max-width: 900px) 100vw, 600px"
      />
    </div>
  ) : (
    <div class:list={['plate__frame', 'plate__frame--43']}>
      <div class="plate__slot">{plate.placeholder ?? 'Image to come'}</div>
    </div>
  )}
  {plate.caption && <div class="caption caption--sm">{plate.caption}</div>}
</div>
