---
const { current } = Astro.props;
const links = [
  { href: '/', label: 'Work' },
  { href: '/lab', label: 'Lab' },
  { href: '/about', label: 'About' },
];
---
<header style="border-bottom:1px solid var(--rule)">
  <div class="wrap" style="display:flex;justify-content:space-between;align-items:center;padding-block:0.9rem;gap:1rem">
    <a href="/" style="font-family:var(--mono);font-size:0.8rem;letter-spacing:0.08em;color:var(--ink);border:0">K. Długosz</a>
    <nav style="display:flex;gap:1.25rem">
      {links.map((l) => (
        <a
          href={l.href}
          aria-current={current === l.label ? 'page' : undefined}
          style={`font-family:var(--mono);font-size:0.78rem;border:0;color:${current === l.label ? 'var(--accent)' : 'var(--ink-mid)'}`}
        >{l.label}</a>
      ))}
    </nav>
  </div>
</header>
