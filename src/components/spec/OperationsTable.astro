---
import { feasibilityLabel, type Operation, type Feasibility } from '../../data/industry';

interface Props {
  operations: Operation[];
  caption?: string;
}

const { operations, caption } = Astro.props;

const order: Feasibility[] = ['machine', 'handling', 'hand'];
const counts = order.map((f) => ({
  f,
  n: operations.filter((op) => op.feasibility === f).length,
}));
---

<div>
  <div class="ops__summary" aria-label="Operations by automation feasibility">
    {counts.map(({ f, n }) => (
      <div class="ops__count">
        <span class="ops__n">{String(n).padStart(2, '0')}</span>
        <span class:list={['ops__tag', `ops__tag--${f}`]}>{feasibilityLabel[f]}</span>
      </div>
    ))}
  </div>

  <div class="spec-wrap">
    <table class="spec ops">
      <thead>
        <tr>
          <th scope="col">#</th>
          <th scope="col">Operation</th>
          <th scope="col">Machine</th>
          <th scope="col" class="spec__num">ISO 4915</th>
          <th scope="col">Automation</th>
        </tr>
      </thead>
      <tbody>
        {operations.map((op, i) => (
          <tr>
            <td class="ops__seq">{String(i + 1).padStart(2, '0')}</td>
            <th scope="row" class="ops__op">{op.op}</th>
            <td class="ops__machine">{op.machine}</td>
            <td class="spec__num">{op.iso ?? '—'}</td>
            <td class="ops__auto">
              <span class:list={['ops__tag', `ops__tag--${op.feasibility}`]}>{feasibilityLabel[op.feasibility]}</span>
              <span class="ops__why">{op.why}</span>
            </td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
  {caption && <div class="caption">{caption}</div>}
</div>
