---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import SiteHeader from '../components/SiteHeader.astro';
import { Image } from 'astro:assets';

const projects = (await getCollection('work', ({ data }) => !data.draft)).sort(
  (a, b) => a.data.order - b.data.order,
);
const [lead, ...rest] = projects;
---
<Base
  title="Katarzyna Długosz — design engineer, physical computing and machine learning"
  description="Design engineer working across soft robotics, physical computing and machine learning, from CAD through to manufacture."
>
  <SiteHeader current="Work" />

  {lead?.data.hero && (
    <a href={`/work/${lead.id}`} class="hero">
      <Image
        src={lead.data.hero}
        alt={lead.data.heroAlt ?? lead.data.title}
        widths={[800, 1400, 2000]}
        sizes="100vw"
        loading="eager"
        style="width:100%;aspect-ratio:2/1;object-fit:cover"
      />
      <div class="wrap hero-cap">
        <span class="meta">{lead.data.kind}, {lead.data.year}</span>
        <h2>{lead.data.title}</h2>
        <p>{lead.data.outcome}</p>
      </div>
    </a>
  )}

  <hr class="rule" />

  <section class="wrap" style="padding-block:clamp(2.5rem,6vw,4rem)">
    <h1 style="max-width:17ch">Objects that sense, move and respond.</h1>
    <p style="font-size:1.05rem;color:var(--ink-mid);max-width:46ch;margin-top:1.25rem">
      I design and build interactive objects — the mechanism, the circuit and the
      software that drives them. Soft robotics, physical computing and machine
      learning, from CAD through to manufacture.
    </p>
  </section>

  <hr class="rule" />

  <div class="wrap grid">
    {rest.map((p) => (
      <a href={`/work/${p.id}`} class="card">
        {p.data.hero ? (
          <Image src={p.data.hero} alt={p.data.heroAlt ?? p.data.title} widths={[400, 800, 1200]} sizes="(max-width: 820px) 92vw, 44vw" style="width:100%;aspect-ratio:4/3;object-fit:cover" />
        ) : (
          <div style="aspect-ratio:4/3;background:var(--figure)"></div>
        )}
        <span class="meta" style="display:block;margin:0.9rem 0 0.3rem">{p.data.kind}, {p.data.year}</span>
        <h3>{p.data.title}</h3>
        <p style="color:var(--ink-mid);font-size:0.94rem;margin-top:0.4rem">{p.data.outcome}</p>
      </a>
    ))}
  </div>

  <hr class="rule" />

  <footer class="wrap" style="padding-block:2.5rem;display:flex;flex-wrap:wrap;gap:1.5rem;justify-content:space-between">
    <p class="meta" style="margin:0">London</p>
    <p class="meta" style="margin:0"><a href="mailto:kasadlugos@gmail.com">kasadlugos@gmail.com</a></p>
  </footer>
</Base>

<style>
  .hero { display: block; border: 0; color: inherit; }
  .hero img { transition: filter 0.4s ease; }
  .hero:hover { background: transparent; }
  .hero:hover img { filter: saturate(1.08) contrast(1.03); }
  .hero-cap { padding-block: 1.25rem 1.75rem; display: grid; gap: 0.35rem; }
  .hero-cap h2 { font-size: clamp(1.8rem, 4.5vw, 2.6rem); }
  .hero-cap p { color: var(--ink-mid); max-width: 46ch; margin: 0; }
  .hero:hover .hero-cap h2 { color: var(--accent); }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 2.5rem;
    padding-block: 2.5rem;
  }
  .card { border: 0; color: inherit; display: block; }
  .card img { transition: filter 0.4s ease; }
  .card:hover { background: transparent; }
  .card:hover img { filter: saturate(1.08) contrast(1.03); }
  .card:hover h3 { color: var(--accent); }
  .card h3 { transition: color 0.2s ease; }
</style>
