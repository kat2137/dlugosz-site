---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import { media, duoFor, hasMedia } from '../lib/media';
import { projects } from '../data/projects';
import { url } from '../lib/paths';

/**
 * The homepage is a contact sheet: nine frames in a three-by-three grid, a word
 * printed under each, so the sheet reads as one sentence about the work. Every
 * frame sits as a duotone print and develops into the photograph on hover.
 *
 * The nine run three to a phrase, and each phrase is one project — hands that
 * learn is the robotic hand, eyes that follow is Sviatovid, cloth that breathes
 * is PneumaBra — so the frame above a word always belongs to it.
 */
/*
 * `focus` is the vertical crop point for the square tile, for the few frames
 * where the middle of the picture is not the subject. The arm cutout is a tall
 * figure whose centre is the wrist bearing, so it is pulled to the top and the
 * tile shows the hand.
 */
const SHEET: { src: string; alt: string; slug: string; title: string; word: string; focus?: string }[] = [
  { src: 'hania-cutout.png', alt: 'The robotic hand, isolated', slug: 'robotic-craftsman', title: 'Robotic Craftsman', word: 'Hands', focus: '5%' },
  { src: 'int-handsewing.jpg', alt: 'Hands sewing a panel, filmed as reference footage', slug: 'robotic-craftsman', title: 'Robotic Craftsman', word: 'that' },
  { src: 'hania-needle-grip.jpg', alt: 'A fingertip holding a needle', slug: 'robotic-craftsman', title: 'Robotic Craftsman', word: 'learn,' },
  { src: 'sviatovid-shell-cad.jpg', alt: 'The face of Sviatovid in CAD', slug: 'sviatovid', title: 'Sviatovid', word: 'eyes' },
  { src: 'sviatovid-eyeball-section.jpg', alt: 'Section through one eye, linkage to the servo horn', slug: 'sviatovid', title: 'Sviatovid', word: 'that' },
  { src: 'pneumabra-prototype-lit.jpg', alt: 'The inflated prototype, lit', slug: 'pneumabra', title: 'PneumaBra', word: 'follow,' },
  { src: 'pn-bra-pattern.png', alt: 'The garment pattern', slug: 'pneumabra', title: 'PneumaBra', word: 'cloth' },
  { src: 'sony-controller-assembled.jpg', alt: "The assembled controller modules", slug: 'hikego', title: 'HikeGo', word: 'that' },
  { src: 'pn-bra-annotated.jpg', alt: 'The annotated garment drawing', slug: 'tech-pack', title: 'Tech pack generator', word: 'breathes.' },
];

/*
 * The portrait is part of the design but must not be load-bearing: a missing
 * image would otherwise throw and take the whole site down at build time,
 * rather than costing one picture. Without it the bio simply runs full width.
 */
const portrait = hasMedia('kd-portrait.jpg') ? media('kd-portrait.jpg') : null;
const portraitDuo = portrait ? duoFor('kd-portrait.jpg') : null;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ProfilePage',
  mainEntity: {
    '@type': 'Person',
    name: 'Katarzyna Długosz',
    jobTitle: 'Robotics and physical-interaction designer and engineer',
    url: 'https://kat2137.github.io/dlugosz-site/',
    sameAs: ['https://github.com/kat2137'],
  },
};
---

<Base
  title="K. Długosz — robotics, interactive materials, interaction software"
  description="Selected work by Katarzyna Długosz: robotic hands, interactive materials, wearable mechanisms and the software that drives them."
  ogImage="hania-cad-render.jpg"
  jsonLd={jsonLd}
>
  <main class="shell">
    <div class="page">
      <Nav />
      <h1 class="visually-hidden">
        Katarzyna Długosz — robotics, interactive materials and interaction software
      </h1>

      <div class="sheet">
        {SHEET.map((tile) => {
          const image = media(tile.src);
          const duo = duoFor(tile.src);
          return (
            <div class="cell" style={tile.focus ? `--focus: ${tile.focus}` : undefined}>
              <a href={url(`work/${tile.slug}`)} aria-label={tile.title}>
                <span class:list={['plate__frame', duo && 'plate__frame--develops']}>
                  {duo && (
                    <Image
                      class="plate__duo"
                      src={duo}
                      alt=""
                      widths={[180, 280, 520]}
                      sizes="(max-width: 860px) 32vw, 260px"
                      aria-hidden="true"
                    />
                  )}
                  <Image
                    class="plate__real"
                    src={image}
                    alt={tile.alt}
                    widths={[180, 280, 520]}
                    sizes="(max-width: 860px) 32vw, 260px"
                    loading="lazy"
                  />
                  <span class="cell__tag">{tile.title}</span>
                </span>
              </a>
              <div class="word">{tile.word}</div>
            </div>
          );
        })}
      </div>

      <div class:list={['intro', !portrait && 'intro--no-portrait']}>
        {portrait && (
        <span class:list={['plate__frame', portraitDuo && 'plate__frame--develops']}>
          {portraitDuo && (
            <Image
              class="plate__duo"
              src={portraitDuo}
              alt=""
              widths={[180, 280, 520]}
              sizes="(max-width: 860px) 200px, 260px"
              aria-hidden="true"
            />
          )}
          <Image
            class="plate__real"
            src={portrait}
            alt="Katarzyna Długosz"
            widths={[180, 280, 520]}
            sizes="(max-width: 860px) 200px, 260px"
            loading="lazy"
          />
        </span>
        )}
        <div>
          <p class="intro__name">Katarzyna Długosz</p>
          <p class="intro__line">
            Designer and engineer building robotic and interactive objects, from the mechanism and
            the electronics to the software that makes them move.
          </p>
        </div>
      </div>

      <h2 class="index__head">Projects</h2>
      <div class="index__list">
        {projects.map((project) => (
          <a class="index__row" href={url(`work/${project.slug}`)}>
            <span class="index__n">{project.number}</span>
            <span>
              <span class="index__t">{project.title}</span>
              <p class="index__s">{project.standfirst}</p>
            </span>
            <span class="index__m">
              <span class="index__lead">{project.discipline} · {project.year}</span>
              {project.tags?.map((tag) => <span class="index__tag">{tag}</span>)}
            </span>
            <span class="index__a" aria-hidden="true">→</span>
          </a>
        ))}
      </div>

      <div class="foot">
        <span>Katarzyna Długosz — London</span>
        <span>
          <a href={url('cv')}>cv →</a>
          &nbsp;·&nbsp;
          <a href={url('about')}>about →</a>
          &nbsp;·&nbsp;
          <a href={url('lab')}>lab →</a>
        </span>
      </div>
    </div>
  </main>
</Base>
