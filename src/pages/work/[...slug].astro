---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import Metrics from '../../components/Metrics.astro';
import Gallery from '../../components/Gallery.astro';
import { Image } from 'astro:assets';
import CodeDrawer from '../../components/CodeDrawer.astro';

export async function getStaticPaths() {
  const projects = await getCollection('work', ({ data }) => !data.draft);
  return projects.map((p) => ({ params: { slug: p.id }, props: { project: p } }));
}

const BASE = '/dlugosz-site';
const { project } = Astro.props;
const { Content } = await render(project);
const d = project.data;
---
<Base title={`${d.title} — Katarzyna Długosz`} description={d.outcome}>
  <SiteHeader />

  <div class="wrap" style="padding-block:clamp(2.5rem,6vw,4rem)">
    <p class="meta" style="margin:0 0 1rem">{d.kind}, {d.year}</p>
    <h1>{d.title}</h1>
    <p style="font-size:1.05rem;color:var(--ink-mid);max-width:46ch;margin-top:1rem">{d.outcome}</p>
  </div>

  {d.hero && (
    <Image src={d.hero} alt={d.heroAlt ?? d.title} widths={[600, 1200, 1800]} sizes="(max-width: 720px) 100vw, 1180px" style="width:100%;aspect-ratio:3/2;object-fit:cover;margin-bottom:2.5rem" />
  )}

  <Metrics metrics={d.metrics} />

  <div class="wrap layout">
    <div class="prose">
      <Content />
    </div>
    <aside class="rail">
      {d.stack.length > 0 && (
        <>
          <p class="label">Built with</p>
          <ul style="list-style:none;padding:0;margin:0 0 2rem;font-family:var(--mono);font-size:0.85rem;line-height:2;color:var(--ink-mid)">
            {d.stack.map((s) => <li>{s}</li>)}
          </ul>
        </>
      )}
      <CodeDrawer slug={project.id} repo={d.repo} />
      {d.credits.length > 0 && (
        <>
          <p class="label">Credits</p>
          <ul style="list-style:none;padding:0;margin:0;font-size:0.85rem;line-height:1.8;color:var(--ink-mid)">
            {d.credits.map((c) => <li>{c}</li>)}
          </ul>
        </>
      )}
    </aside>
  </div>

  <Gallery items={d.gallery} />

  <hr class="rule" />
  <div class="wrap" style="padding-block:2rem">
    <a href={BASE}>Back to work</a>
  </div>
</Base>

<style>
  .layout {
    display: grid;
    grid-template-columns: minmax(0, 1.7fr) minmax(0, 1fr);
    gap: 3rem;
    padding-block: 2.5rem;
    align-items: start;
  }
  .rail { position: sticky; top: 1.5rem; }

  /* numbered sections — gives a skimmer somewhere to land */
  .prose { counter-reset: section; }
  .prose :global(h2) {
    counter-increment: section;
    margin: 2.75rem 0 0.9rem;
    display: grid;
    grid-template-columns: 2.75rem 1fr;
    align-items: baseline;
  }
  .prose :global(h2)::before {
    content: counter(section, decimal-leading-zero);
    font-family: var(--mono);
    font-size: 0.72rem;
    font-weight: 400;
    letter-spacing: 0.08em;
    color: var(--accent);
  }
  .prose :global(h2:first-child) { margin-top: 0; }
  .prose :global(p) { font-size: 1.02rem; }

  /* a blockquote becomes the pull-quote for that section */
  .prose :global(blockquote) {
    margin: 2rem 0;
    padding-left: 1.25rem;
    border-left: 3px solid var(--fill);
    font-family: var(--display);
    font-size: 1.5rem;
    line-height: 1.3;
    letter-spacing: -0.02em;
  }
  .prose :global(blockquote p) { font-size: inherit; margin: 0; }

  @media (max-width: 820px) {
    .layout { grid-template-columns: 1fr; gap: 2rem; }
    .rail { position: static; }
    .prose :global(h2) { grid-template-columns: 2.25rem 1fr; }
  }
</style>
