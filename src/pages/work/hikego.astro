---
import ProjectPage from '../../layouts/ProjectPage.astro';
import Band from '../../components/Band.astro';
import Figure from '../../components/Figure.astro';
import Brief from '../../components/Brief.astro';
import CodeViewer from '../../components/CodeViewer.astro';
import Contents from '../../components/Contents.astro';
import SignalTable from '../../components/sony/SignalTable.astro';
import CommandLayer from '../../components/sony/CommandLayer.astro';
import { bySlug } from '../../data/projects';
import { sonyScripts } from '../../data/repos';
import { sections } from '../../data/sections/sony';

const project = bySlug.hikego;
---

<ProjectPage project={project} ogImage="sony-app-header-2.png">
  <Band label="fig. 01" sub="companion app">
    <Figure
      src="sony-app-header-2.png"
      alt="Companion app screens: the mapped location with a quest timer and calorie count, a Social and Game card offering Explore the Garden, Truth or Dare and Treasure Hunt, and a GPS navigation card explaining that the cube signals direction at forks in the road"
      aspect="16/9"
      caption="fig. 01 — the companion app: mapped location, game selection and the cube as a direction signal"
      widths={[640, 960, 1280]}
      sizes="(max-width: 900px) 100vw, 910px"
    />
  </Band>

  <Brief project={project} />

  <Band label="fig. 02—03" sub="signals">
    <div class="stack">
      <SignalTable />
      <CommandLayer />
    </div>
  </Band>

  <CodeViewer repo={sonyScripts} figure="fig. 04" surface />

  <Contents sections={sections} plateStyle="sony" />
</ProjectPage>
