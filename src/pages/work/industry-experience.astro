---
import ProjectPage from '../../layouts/ProjectPage.astro';
import Band from '../../components/Band.astro';
import Brief from '../../components/Brief.astro';
import Figure from '../../components/Figure.astro';
import SizeMatrix from '../../components/spec/SizeMatrix.astro';
import PackPages from '../../components/spec/PackPages.astro';
import { bySlug } from '../../data/projects';

const project = bySlug['industry-experience'];
---

<ProjectPage project={project} ogImage="dissolve-top-flats.jpg">
  <Band label="fig. 01" sub="the style">
    <Figure
      src="dissolve-top-flats.jpg"
      alt="DISSOLVE Ripple bikini top, front and back flats in dark cobalt with off-white binding and wave piping"
      aspect="1890/807"
      fit="contain"
      caption="fig. 01 — Ripple bikini top, style 03, rendered in CLO3D: triangle cup, non-wired, crossback straps, adjustable back"
      widths={[640, 960, 1280]}
      sizes="(max-width: 900px) 100vw, 910px"
    />
  </Band>

  <Brief project={project} />

  <Band label="fig. 02" sub="oxytocin aw27">
    <Figure
      src="dissolve-oxytocin-moodboard.jpg"
      alt="DISSOLVE moodboard for the Oxytocin AW27 collection with Community Sauna Baths: contrast binding on swimwear, wave lines, vintage swim shorts, and the two Pantone colours, Cloud Dancer and Surf the Web"
      aspect="1600/1189"
      fit="contain"
      caption="fig. 02 — Oxytocin AW27: a swimwear capsule with an inclusive sizing range, designed and developed for Community Sauna Baths"
      widths={[640, 960, 1280, 1600]}
      sizes="(max-width: 900px) 100vw, 910px"
    />
  </Band>

  <Band label="fig. 03—05" sub="clo3d">
    <div class="stack">
      <Figure
        src="dissolve-clo3d-lineup.jpg"
        alt="The Oxytocin line-up rendered in CLO3D, front and back: swim short, brief, bikini top and bikini brief, swimsuit — navy with white binding and wave piping"
        aspect="1384/828"
        fit="contain"
        caption="fig. 03 — the line-up, front and back, laid out from CLO3D"
        widths={[640, 960, 1384]}
        sizes="(max-width: 900px) 100vw, 910px"
      />
      <div class="duo">
        <Figure src="dissolve-clo3d-swimsuit.jpg" alt="CLO3D render of the swimsuit on an avatar" aspect="646/1116" fit="cover" caption="fig. 04 — swimsuit on the avatar, CLO3D" small />
        <Figure src="dissolve-clo3d-bikini.jpg" alt="CLO3D render of the bikini top and bikini brief on an avatar" aspect="716/1000" fit="cover" caption="fig. 05 — bikini top and brief on the avatar, CLO3D" small />
      </div>
    </div>
  </Band>

  <Band label="fig. 06" sub="construction">
    <Figure
      src="dissolve-top-callouts.jpg"
      alt="Construction page for the bikini top: front and back drawings with callouts for every seam, binding, piping, loop and trim"
      aspect="2000/1125"
      fit="contain"
      caption="fig. 06 — every finish written down: binding, elastic, stitch, what is bagged out and what is topstitched"
      widths={[640, 960, 1280, 1800]}
      sizes="(max-width: 900px) 100vw, 910px"
    />
  </Band>

  <Band label="fig. 07" sub="inside">
    <Figure
      src="dissolve-top-inside-bom.jpg"
      alt="Back inside view of the bikini top with callouts for the strap loop, self-loop, wing sliders, back clip and care label"
      aspect="1002/945"
      fit="contain"
      caption="fig. 07 — back inside view: how the back adjusts, and what holds it"
      widths={[480, 760, 1000]}
      sizes="(max-width: 900px) 100vw, 560px"
    />
  </Band>

  <Band label="fig. 08" sub="measurement">
    <div class="duo duo--spec">
      <Figure
        src="dissolve-top-pom-sketch.jpg"
        alt="Front and back drawings of the bikini top with thirteen numbered measurement points"
        aspect="1260/915"
        fit="contain"
        caption="fig. 08 — thirteen points of measure, sample size 34F"
        small
      />
      <p class="body">
        Every point is defined on the drawing and carries its own tolerance — tighter on the
        cup, looser around the full underband, where the elastic gives. The values themselves
        stay in the pack.
      </p>
    </div>
  </Band>

  <Band label="fig. 09" sub="sizing system">
    <p class="body spec__intro">
      One pattern, graded on two axes. The band steps with the underbust, and within each
      band the cup steps with the bust, so each pattern piece has its own increment per cup
      step and per band step rather than one overall scale.
    </p>
    <SizeMatrix caption="fig. 09 — eighteen sizes from one bikini top pattern: three bands by six cup groups" />
  </Band>

  <Band label="fig. 10" sub="the full pack">
    <PackPages caption="fig. 10 — the bikini top’s pack, page by page; the full pack is shared on request under a confidentiality agreement" />
  </Band>

  <Band label="fig. 11—13" sub="fittings">
    <p class="body spec__intro">
      Samples are fitted on the stand and on the body, and every fitting goes back into the
      pattern as a correction — piping lines redrawn, binding tension adjusted, prints placed.
    </p>
    <div class="triptych triptych--fluid">
      <Figure src="dissolve-fit-top.jpg" alt="Navy bikini top sample with white binding and piping on a 1XL dress stand" aspect="3/4" fit="cover" caption="fig. 11 — bikini top sample, 1XL" small />
      <Figure src="dissolve-fit-swimsuit.jpg" alt="Navy swimsuit sample with white binding and wave piping on a 1XL dress stand" aspect="3/4" fit="cover" caption="fig. 12 — swimsuit sample, 1XL" small />
      <Figure src="dissolve-fit-brief.jpg" alt="Brief sample with white waistband tie and piping on a dress stand" aspect="3/4" fit="cover" caption="fig. 13 — brief sample" small />
    </div>
  </Band>

  <Band label="fig. 14—16" sub="sample to correction">
    <div class="stack">
      <div class="duo">
        <Figure src="dissolve-sample-swimsuit-inside.jpg" alt="The swimsuit production sample laid flat, back straps, clip and grey lining visible, with DISSOLVE and Community Sauna Baths prints" aspect="3/4" fit="cover" caption="fig. 14 — swimsuit sample: lining, removable back straps, clip" small />
        <Figure src="dissolve-sample-short.jpg" alt="The navy swim short sample laid flat, with white wave piping, drawcord and DISSOLVE print" aspect="3/4" fit="cover" caption="fig. 15 — short sample, piping and prints placed" small />
      </div>
      <div style="max-width: 560px">
        <Figure src="dissolve-fit-comment.jpg" alt="Back view of the short worn, with the piping line redrawn over the photo and annotated" aspect="414/286" fit="contain" caption="fig. 16 — fit comment: the back piping line redrawn on the photo, then corrected on the pattern" small />
      </div>
    </div>
  </Band>

</ProjectPage>
